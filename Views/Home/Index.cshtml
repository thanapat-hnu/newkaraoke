@model IEnumerable<newkaraoke.Models.db.User>

@{
    Layout = "";
}

<div>
    <h1>Users</h1>

    <table border="1">
        <tr>
            <th>Id</th>
            <th>Name</th>
        </tr>

        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Name</td>
            </tr>
        }
    </table>
</div>
