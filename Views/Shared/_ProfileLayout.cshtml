<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>โปรไฟล์ — Neon Star Karaoke</title>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="~/css/shared.css" />
  <style>
/* Avatar */
.avatar {
  width: 72px; height: 72px; border-radius: 50%;
  background: var(--ns-ink); color: #F2F0EB;
  font-family: 'Kanit', sans-serif; font-size: 1.6rem; font-weight: 900;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
/* Stat cards */
.ns-stat-card { background: var(--ns-surface); border: 1px solid var(--ns-border); }
.stat-val { font-family: 'Kanit', sans-serif; font-size: 1.5rem; font-weight: 900; line-height: 1; }

/* Activity bar */
.activity-bar { display: flex; gap: 3px; align-items: flex-end; height: 48px; }
.act-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.act-bar { width: 100%; background: var(--ns-ink); border-radius: 1px 1px 0 0; min-height: 2px; }
.act-lbl { font-size: .55rem; color: var(--ns-ink3); font-family: 'Kanit', sans-serif; }

/* Bootstrap nav-tabs override */
.profile-tabs .nav-link {
  font-family: 'Kanit', sans-serif; font-size: .78rem; font-weight: 600;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--ns-ink3) !important; border: none !important;
  border-bottom: 2px solid transparent !important;
  padding: .65rem 1.25rem !important; border-radius: 0 !important;
}
.profile-tabs .nav-link.active { color: var(--ns-ink) !important; border-bottom-color: var(--ns-ink) !important; }
.profile-tabs { border-bottom: 1px solid var(--ns-border) !important; }

/* Booking rows */
.bk-row { background: var(--ns-surface); transition: background .15s; }
.bk-row:hover { background: var(--ns-bg); }
.bk-day { font-family: 'Kanit', sans-serif; font-size: 1.4rem; font-weight: 900; line-height: 1; }
.bk-month { font-size: .65rem; color: var(--ns-ink3); text-transform: uppercase; }

/* Fav cards */
.fav-card { background: var(--ns-surface); transition: background .15s; }
.fav-card:hover { background: var(--ns-bg2); }
.fav-rank { font-family: 'Kanit', sans-serif; font-size: 3rem; font-weight: 900; color: rgba(28,28,26,.06); line-height: 1; }

/* Info rows */
.info-row { border-bottom: 1px solid var(--ns-border); font-size: .875rem; }
.info-l { color: var(--ns-ink3); }
</style>
</head>

<body>

<!-- NAVBAR -->
   <nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="index">Neon Star<sup>Karaoke</sup></a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-md-center gap-md-3 gap-2 py-2 py-md-0" id="navR">
        <li class="nav-item"><a class="nav-link" href="index">หน้าแรก</a></li>
        <li class="nav-item"><a class="nav-link" href="booking">จองห้อง</a></li>
        <li class="nav-item ms-md-2">
          <a href="Auth" class="btn btn-outline-secondary btn-sm px-3">เข้าสู่ระบบ</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

  @RenderBody()
  
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Profile.js"></script>

</body>

</html>