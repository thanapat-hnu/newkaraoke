<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Star Karaoke</title>
    <link
    href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap"
    rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shared.css"/>

    <style>
/* ── Hero (scroll full-height ทำ Bootstrap ไม่มี) ── */
.hero-section {
  min-height: calc(100vh - 56px);
  background: var(--ns-bg);
  display: flex; align-items: center;
}

.hero-h1 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(3.5rem, 8vw, 7rem);
  font-weight: 900; line-height: .9; letter-spacing: -3px;
  margin-bottom: 2rem;
}

/* About section (dark bg) */
.about-section {
  background: var(--ns-ink); position: relative;
}
.about-section::before {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(242,240,235,.04) 1px, transparent 1px);
  background-size: 28px 28px;
}
.about-h2 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 900; line-height: .95; letter-spacing: -2px;
  color: var(--ns-bg);
}

/* Feature rows */
.feat-item {
  background: rgba(242,240,235,.04);
  border: 1px solid rgba(242,240,235,.06);
  border-radius: 3px; transition: background .2s;
}
.feat-item:hover { background: rgba(242,240,235,.07); }

/* Rooms grid */
.rooms-section { background: var(--ns-bg2); }
.room-card-item {
  background: var(--ns-surface); border: 1px solid var(--ns-border);
  transition: background .15s; cursor: default;
}
.room-card-item:hover { background: var(--ns-bg); }
.rc-num {
  font-family: 'Kanit', sans-serif; font-size: 3rem; font-weight: 900;
  color: rgba(28,28,26,.06); line-height: 1;
}
.rc-price-lg { font-family: 'Kanit', sans-serif; font-size: 1.3rem; font-weight: 900; }

/* Stat cards */
.stat-card-item { background: var(--ns-surface); border: 1px solid var(--ns-border); }
.stat-n-lg { font-family: 'Kanit', sans-serif; font-size: 2rem; font-weight: 900; }

/* CTA section */
.cta-section { background: var(--ns-bg3); border-top: 1px solid var(--ns-border-md); }
@* Booking *@
/* ── เฉพาะส่วนที่ Bootstrap ทำไม่ได้ ── */

/* Step accordion */
.step-item { border: 1px solid var(--ns-border); border-radius: 4px !important; margin-bottom: 10px; }
.step-item.active { box-shadow: 0 0 0 2px var(--ns-ink); }
.step-btn {
  background: var(--ns-surface) !important; cursor: pointer;
  display: flex; align-items: center; gap: 14px;
  padding: 1rem 1.25rem; width: 100%;
  border: none; text-align: left;
  transition: background .15s;
}
.step-item.active .step-btn { background: var(--ns-bg) !important; cursor: default; }
.step-item.locked .step-btn { cursor: not-allowed; }
.step-num-badge {
  width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
  border: 1.5px solid var(--ns-border-md);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Kanit', sans-serif; font-size: .72rem; font-weight: 700;
  color: var(--ns-ink3); transition: all .3s;
}
.step-item.active .step-num-badge,
.step-item.done   .step-num-badge { background: var(--ns-ink); border-color: var(--ns-ink); color: #F2F0EB; }
.step-val { font-size: .78rem; color: var(--ns-ink3); margin-top: 1px; }
.step-val.filled { color: var(--ns-ink2); font-weight: 500; }
.step-body { display: none; padding: 0 1.25rem 1.25rem; background: var(--ns-bg); }
.step-item.active .step-body { display: block; }
.step-chevron { font-size: .7rem; color: var(--ns-ink3); transition: transform .2s; margin-left: auto; }
.step-item.active .step-chevron { transform: rotate(180deg); }

/* Calendar */
.cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 3px; }
.cal-dow { font-size: .6rem; font-weight: 700; letter-spacing: 1px; color: var(--ns-ink3); text-align: center; padding: 4px 0; text-transform: uppercase; }
.cal-day {
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  font-family: 'Kanit', sans-serif; font-size: .82rem; font-weight: 500;
  border-radius: 2px; cursor: pointer; border: 1px solid transparent;
  transition: background .15s;
}
.cal-day:hover:not(.disabled):not(.empty) { background: var(--ns-bg2); }
.cal-day.today    { border-color: var(--ns-border-md); }
.cal-day.selected { background: var(--ns-ink) !important; color: #F2F0EB !important; }
.cal-day.disabled { color: var(--ns-bg3); cursor: not-allowed; }
.cal-day.empty    { cursor: default; }
.cal-day.has-bk   { position: relative; }
.cal-day.has-bk::after { content: ''; width: 3px; height: 3px; border-radius: 50%; background: var(--ns-ink3); position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); }

/* People picker */
.ppl-picker { display: flex; align-items: center; border: 1px solid var(--ns-border-md); border-radius: 3px; overflow: hidden; width: fit-content; }
.ppl-btn { width: 38px; height: 38px; background: var(--ns-surface); border: none; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s; color: var(--ns-ink); }
.ppl-btn:hover { background: var(--ns-bg2); }
.ppl-num { font-family: 'Kanit', sans-serif; font-size: 1.1rem; font-weight: 700; padding: 0 1.2rem; border-left: 1px solid var(--ns-border); border-right: 1px solid var(--ns-border); height: 38px; display: flex; align-items: center; }

/* Room cards (step 3) */
.room-sel-card { border: 1px solid var(--ns-border); border-radius: 3px; cursor: pointer; background: var(--ns-bg); transition: border-color .15s, background .15s; }
.room-sel-card:hover:not(.rc-busy) { background: var(--ns-bg2); }
.room-sel-card.rc-selected { border-color: var(--ns-ink); border-width: 2px; }
.room-sel-card.rc-busy { opacity: .38; cursor: not-allowed; }

/* Timeline */
.tl-header { display: flex; margin-bottom: 6px; padding-left: 44px; }
.tl-hour-label { flex: 1; font-family: 'Kanit', sans-serif; font-size: .6rem; color: var(--ns-ink3); }
.tl-row { display: flex; align-items: stretch; gap: 8px; }
.tl-room-name { width: 36px; font-family: 'Kanit', sans-serif; font-size: .62rem; color: var(--ns-ink3); display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; padding-right: 4px; }
.tl-track { flex: 1; height: 32px; background: var(--ns-bg2); border-radius: 3px; position: relative; cursor: crosshair; border: 1px solid var(--ns-border); user-select: none; }
.tl-track:hover { background: var(--ns-bg3); }
.tl-seg { position: absolute; top: 0; bottom: 0; border-radius: 2px; pointer-events: none; }
.tl-seg-booked { background: var(--ns-ink2); }
.tl-selection { position: absolute; top: 0; bottom: 0; background: var(--ns-ink); opacity: .85; border-radius: 2px; pointer-events: none; display: flex; align-items: center; justify-content: center; }
.tl-sel-label { font-family: 'Kanit', sans-serif; font-size: .6rem; font-weight: 700; color: #F2F0EB; white-space: nowrap; padding: 0 4px; }
.tl-tick { position: absolute; top: 0; bottom: 0; width: 1px; background: rgba(28,28,26,.06); pointer-events: none; }

/* Summary box */
.sum-box { background: var(--ns-bg3); border: 1px solid var(--ns-border); border-radius: 3px; }
.s-row { display: flex; justify-content: space-between; font-size: .86rem; padding: 4px 0; color: var(--ns-ink2); }
.s-row .sl { color: var(--ns-ink3); }
.s-row.stot { border-top: 1px solid var(--ns-border-md); margin-top: 8px; padding-top: 10px; font-family: 'Kanit', sans-serif; font-weight: 700; font-size: .95rem; }

/* Payment method cards */
.pay-method-card { border: 1px solid var(--ns-border); border-radius: 3px; padding: .85rem .75rem; cursor: pointer; text-align: center; background: var(--ns-bg); transition: border-color .15s, background .15s; }
.pay-method-card:hover { background: var(--ns-bg2); }
.pay-method-card.active { border-color: var(--ns-ink); border-width: 2px; }

/* Card preview */
.card-preview { background: var(--ns-ink); border-radius: 6px; padding: 1.25rem; color: #F2F0EB; height: 140px; display: flex; flex-direction: column; justify-content: space-between; font-family: 'Kanit', sans-serif; }

/* QR box */
.qr-box { background: var(--ns-surface); border: 1px solid var(--ns-border); border-radius: 3px; padding: 1.5rem 2rem; text-align: center; font-family: monospace; }

@* Login *@
.auth-page {
  min-height: calc(100vh - 56px);
  display: flex; align-items: center; justify-content: center;
  padding: 2rem; position: relative; z-index: 1;
}
/* Bootstrap nav-tabs override ให้ตรงกับ design */
.auth-tabs .nav-link {
  font-family: 'Kanit', sans-serif; font-size: .78rem; font-weight: 700;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--ns-ink3) !important; border-radius: 0 !important;
  border: none !important; border-bottom: 2px solid transparent !important;
  padding: 12px 0 !important; flex: 1; text-align: center;
}
.auth-tabs .nav-link.active {
  color: var(--ns-ink) !important;
  border-bottom-color: var(--ns-ink) !important;
  background: var(--ns-bg) !important;
}
.auth-tabs { border-bottom: 1px solid var(--ns-border) !important; }
.auth-heading { font-family: 'Kanit', sans-serif; font-size: 1.3rem; font-weight: 900; letter-spacing: -.5px; }

@* Profile *@
/* Avatar */
.avatar {
  width: 72px; height: 72px; border-radius: 50%;
  background: var(--ns-ink); color: #F2F0EB;
  font-family: 'Kanit', sans-serif; font-size: 1.6rem; font-weight: 900;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
/* Stat cards */
.ns-stat-card { background: var(--ns-surface); border: 1px solid var(--ns-border); }
.stat-val { font-family: 'Kanit', sans-serif; font-size: 1.5rem; font-weight: 900; line-height: 1; }

/* Activity bar */
.activity-bar { display: flex; gap: 3px; align-items: flex-end; height: 48px; }
.act-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.act-bar { width: 100%; background: var(--ns-ink); border-radius: 1px 1px 0 0; min-height: 2px; }
.act-lbl { font-size: .55rem; color: var(--ns-ink3); font-family: 'Kanit', sans-serif; }

/* Bootstrap nav-tabs override */
.profile-tabs .nav-link {
  font-family: 'Kanit', sans-serif; font-size: .78rem; font-weight: 600;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--ns-ink3) !important; border: none !important;
  border-bottom: 2px solid transparent !important;
  padding: .65rem 1.25rem !important; border-radius: 0 !important;
}
.profile-tabs .nav-link.active { color: var(--ns-ink) !important; border-bottom-color: var(--ns-ink) !important; }
.profile-tabs { border-bottom: 1px solid var(--ns-border) !important; }

/* Booking rows */
.bk-row { background: var(--ns-surface); transition: background .15s; }
.bk-row:hover { background: var(--ns-bg); }
.bk-day { font-family: 'Kanit', sans-serif; font-size: 1.4rem; font-weight: 900; line-height: 1; }
.bk-month { font-size: .65rem; color: var(--ns-ink3); text-transform: uppercase; }

/* Fav cards */
.fav-card { background: var(--ns-surface); transition: background .15s; }
.fav-card:hover { background: var(--ns-bg2); }
.fav-rank { font-family: 'Kanit', sans-serif; font-size: 3rem; font-weight: 900; color: rgba(28,28,26,.06); line-height: 1; }

/* Info rows */
.info-row { border-bottom: 1px solid var(--ns-border); font-size: .875rem; }
.info-l { color: var(--ns-ink3); }
</style>
</head>

<body>
    <!-- ══ NAVBAR (Bootstrap) ══════════════════════════════════ -->
<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="/user/index">Neon Star<sup>Karaoke</sup></a>

    @* Burger — Bootstrap วาง right อัตโนมัติ ms-auto ใช้งานได้เลย *@
    <button class="navbar-toggler border-0 ms-auto" type="button"
            data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-md-center gap-md-3 gap-2 py-3 py-md-0">
        @{
            var currentPath = Context.Request.Path.Value?.ToLower();
        }
        <li class="nav-item">
            <a class="nav-link @(currentPath == "/user/index" || currentPath == "/" ? "active" : "")"
               href="/user/index">หน้าแรก</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentPath == "/user/booking" ? "active" : "")"
               href="/user/booking">จองห้อง</a>
        </li>
        @if (Context.Session.GetString("UserId") != null)
        {
            <li class="nav-item">
                <a class="nav-link @(currentPath == "/user/profile" ? "active" : "")"
                   href="/user/profile">@Context.Session.GetString("UserName")</a>
            </li>
            <li class="nav-item">
                <form asp-controller="User" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm px-3">ออกจากระบบ</button>
                </form>
            </li>
        }
        else
        {
            <li class="nav-item ms-md-2">
                <a href="/user/auth" class="btn btn-outline-secondary btn-sm px-3">เข้าสู่ระบบ</a>
            </li>
            <li class="nav-item">
                <a href="/user/booking" class="btn btn-dark btn-sm px-3">จองเลย</a>
            </li>
        }
      </ul>
    </div>
  </div>
</nav>

    @RenderBody()

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/index.js"></script>
  @* <script src="~/js/Booking.js"></script> *@
  @* <script src="~/js/Login.js"></script> *@
  @* <script src="~/js/Profile.js"></script> *@
  @* <script src="~/js/staff.js"></script> *@
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>