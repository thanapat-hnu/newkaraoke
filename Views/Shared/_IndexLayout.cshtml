<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Star Karaoke</title>
    <link
    href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap"
    rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shared.css"/>

    <style>
/* ── Hero (scroll full-height ทำ Bootstrap ไม่มี) ── */
.hero-section {
  min-height: calc(100vh - 56px);
  background: var(--ns-bg);
  display: flex; align-items: center;
}
.hero-h1 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(3.5rem, 8vw, 7rem);
  font-weight: 900; line-height: .9; letter-spacing: -3px;
  margin-bottom: 2rem;
}

/* About section (dark bg) */
.about-section {
  background: var(--ns-ink); position: relative;
}
.about-section::before {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(242,240,235,.04) 1px, transparent 1px);
  background-size: 28px 28px;
}
.about-h2 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 900; line-height: .95; letter-spacing: -2px;
  color: var(--ns-bg);
}

/* Feature rows */
.feat-item {
  background: rgba(242,240,235,.04);
  border: 1px solid rgba(242,240,235,.06);
  border-radius: 3px; transition: background .2s;
}
.feat-item:hover { background: rgba(242,240,235,.07); }

/* Rooms grid */
.rooms-section { background: var(--ns-bg2); }
.room-card-item {
  background: var(--ns-surface); border: 1px solid var(--ns-border);
  transition: background .15s; cursor: default;
}
.room-card-item:hover { background: var(--ns-bg); }
.rc-num {
  font-family: 'Kanit', sans-serif; font-size: 3rem; font-weight: 900;
  color: rgba(28,28,26,.06); line-height: 1;
}
.rc-price-lg { font-family: 'Kanit', sans-serif; font-size: 1.3rem; font-weight: 900; }

/* Stat cards */
.stat-card-item { background: var(--ns-surface); border: 1px solid var(--ns-border); }
.stat-n-lg { font-family: 'Kanit', sans-serif; font-size: 2rem; font-weight: 900; }

/* CTA section */
.cta-section { background: var(--ns-bg3); border-top: 1px solid var(--ns-border-md); }
</style>
</head>

<body>
    <!-- ══ NAVBAR (Bootstrap) ══════════════════════════════════ -->
<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="index">Neon Star<sup>Karaoke</sup></a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-md-center gap-md-3 gap-2 py-2 py-md-0">
        <li class="nav-item"><a class="nav-link active" href="index">หน้าแรก</a></li>
        <li class="nav-item"><a class="nav-link" href="booking">จองห้อง</a></li>
        <li class="nav-item"><a class="nav-link" href="profile">โปรไฟล์</a></li>
        <li class="nav-item ms-md-2">
          <a href="login" class="btn btn-outline-secondary btn-sm px-3">เข้าสู่ระบบ</a>
        </li>
        <li class="nav-item">
          <a href="booking" class="btn btn-dark btn-sm px-3">จองเลย</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

    @RenderBody()


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>