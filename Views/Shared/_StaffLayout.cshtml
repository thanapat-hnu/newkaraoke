<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Neon Star — Admin Panel</title>
  <link
  href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap"
  rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
  <link rel="stylesheet" href="~/css/staff.css" />

</head>

<body class="d-flex">

  <!-- ══ SIDEBAR ════════════════════════════════════════════ -->
  <div id="sb">
    <div class="sb-logo">
      <div class="sb-name">Neon Star<span class="sb-sup">KARAOKE</span></div>
      <div id="sbBadge" class="sb-role-badge role-admin">Admin</div>
    </div>
    <nav class="sb-nav" id="sbNav"></nav>
    <div class="sb-footer">
      <div class="sb-user" id="sbUser"></div>
      <button class="sb-logout" onclick="doLogout()">ออกจากระบบ</button>
    </div>
  </div>
  
  @RenderBody()

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/staff.js"></script>

</body>

</html>