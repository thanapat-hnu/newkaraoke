@* Views/Shared/_ITLayout.cshtml *@
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title — Neon Star IT</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-shared.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex">

    <div id="sb">
        <div class="sb-logo">
            <div class="sb-name">Neon Star<span class="sb-sup">KARAOKE</span></div>
            <div class="sb-role-badge role-@Context.Session.GetString("UserRole")">
                @Context.Session.GetString("UserRole")
            </div>
        </div>

        <nav class="sb-nav">
            <div class="sb-sec">Management</div>
            <a class="sb-item @(ViewBag.ActiveNav == "users"      ? "active" : "")"
               asp-controller="IT" asp-action="Users">
                <span class="sb-icon">⊡</span> ผู้ใช้ระบบ
            </a>
            <a class="sb-item @(ViewBag.ActiveNav == "promotions" ? "active" : "")"
               asp-controller="IT" asp-action="Promotions">
                <span class="sb-icon">✦</span> โปรโมชั่น
            </a>
            <a class="sb-item @(ViewBag.ActiveNav == "logs"       ? "active" : "")"
               asp-controller="IT" asp-action="Logs">
                <span class="sb-icon">≡</span> Activity Log
            </a>
        </nav>

        <div class="sb-footer">
            <div class="sb-user">
                <strong>@Context.Session.GetString("UserName")</strong><br>
                <span style="font-size:.65rem;">@Context.Session.GetString("UserRole")</span>
            </div>
            <form asp-controller="StaffAuth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sb-logout">ออกจากระบบ</button>
            </form>
        </div>
    </div>

    <div id="main" class="flex-grow-1 overflow-x-hidden">
        <div class="topbar d-flex align-items-center justify-content-between px-3">
            <div class="topbar-title">@ViewBag.Title</div>
            <a href="/" class="tl" style="font-size:.75rem;color:var(--ns-ink3);text-decoration:none;">หน้าลูกค้า ↗</a>
        </div>
        @RenderBody()
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
        <div id="liveToast" class="toast text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toastMsg"
                     style="font-family:'Kanit',sans-serif;font-size:.8rem;"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script>
        function showToast(msg) {
            document.getElementById('toastMsg').textContent = msg;
            new bootstrap.Toast(document.getElementById('liveToast'), { delay: 3000 }).show();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
