@* Views/Shared/_AdminLayout.cshtml — CEO / Admin *@
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title — Neon Star Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;900&family=Sarabun:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-shared.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex">

    <div id="sb">
        <div class="sb-logo">
            <div class="sb-name">Neon Star<span class="sb-sup">KARAOKE</span></div>
            <div class="sb-role-badge role-admin">CEO</div>
        </div>

        <nav class="sb-nav">
            <div class="sb-sec">Analytics</div>
            <a class="sb-item @(ViewBag.ActiveNav == "revenue"   ? "active" : "")"
               asp-controller="Ceo" asp-action="Revenue">
                <span class="sb-icon">◎</span> รายรับ
            </a>
            <a class="sb-item @(ViewBag.ActiveNav == "rooms"     ? "active" : "")"
               asp-controller="Ceo" asp-action="Rooms">
                <span class="sb-icon">◫</span> ห้อง
            </a>
            <a class="sb-item @(ViewBag.ActiveNav == "heatmap"   ? "active" : "")"
               asp-controller="Ceo" asp-action="Heatmap">
                <span class="sb-icon">▦</span> Heatmap
            </a>
            <a class="sb-item @(ViewBag.ActiveNav == "customers" ? "active" : "")"
               asp-controller="Ceo" asp-action="Customers">
                <span class="sb-icon">◷</span> ลูกค้า
            </a>
        </nav>

        <div class="sb-footer">
            <div class="sb-user">
                <strong>@Context.Session.GetString("UserName")</strong><br>
                <span style="font-size:.65rem;">Administrator</span>
            </div>
            <form asp-controller="StaffAuth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sb-logout">ออกจากระบบ</button>
            </form>
        </div>
    </div>

    <div id="main" class="flex-grow-1 overflow-x-hidden">
        <div class="topbar d-flex align-items-center justify-content-between px-3">
            <div class="topbar-title">@ViewBag.Title</div>
            <div class="d-flex align-items-center gap-2">
                <div class="d-flex gap-1">
                    <a asp-controller="Ceo" asp-action="@ViewBag.CurrentAction"
                       asp-route-range="7"
                       class="dr-btn @(ViewBag.Range == 7  ? "active" : "")">7 วัน</a>
                    <a asp-controller="Ceo" asp-action="@ViewBag.CurrentAction"
                       asp-route-range="30"
                       class="dr-btn @(ViewBag.Range == 30 ? "active" : "")">30 วัน</a>
                    <a asp-controller="Ceo" asp-action="@ViewBag.CurrentAction"
                       asp-route-range="90"
                       class="dr-btn @(ViewBag.Range == 90 ? "active" : "")">90 วัน</a>
                    <a asp-controller="Ceo" asp-action="@ViewBag.CurrentAction"
                       asp-route-range="0"
                       class="dr-btn @(ViewBag.Range == 0  ? "active" : "")">ทั้งหมด</a>
                </div>
                <a href="/User/Index" style="font-size:.75rem;color:var(--ns-ink3);text-decoration:none;padding:3px 7px;">หน้าลูกค้า ↗</a>
            </div>
        </div>
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
