@model IEnumerable<newkaraoke.Models.db.Promotion>
@{
    Layout = "_StaffLayout";
    ViewBag.Title = "โปรโมชั่น";
    ViewBag.ActiveNav = "promotions";
    var today = (DateOnly)ViewBag.Today;
}

<div class="p-4" style="position:relative;z-index:1;">

    <div class="pg-ttl">โปรโมชั่น</div>
    <p class="pg-sub mb-3">ดูรายการโปรโมชั่นที่ใช้งานได้</p>

    @if (!Model.Any())
    {
        <div class="tc">
            <div class="p-4 text-center text-secondary small">ยังไม่มีโปรโมชั่น</div>
        </div>
    }
    else
    {
        <div class="tc">
            <div class="th">
                <div class="th-ttl">โปรโมชั่นทั้งหมด (@Model.Count() รายการ)</div>
            </div>
            <div class="table-responsive">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>ชื่อ / โค้ด</th>
                            <th>คำอธิบาย</th>
                            <th>ส่วนลด</th>
                            <th>ระยะเวลา</th>
                            <th>ใช้แล้ว / จำกัด</th>
                            <th>สถานะ</th>
                            <th>สร้างโดย</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var isExpired = p.EndDate < today;
                            var isOn      = (p.IsActive ?? false) && !isExpired;

                            <tr style="@(!isOn ? "opacity:.6;" : "")">
                                <td>
                                    <div style="font-family:'Kanit',sans-serif;font-weight:700;font-size:.9rem;">@p.Name</div>
                                    @if (!string.IsNullOrEmpty(p.Condition))
                                    {
                                        <div style="font-size:.7rem;color:var(--ns-ink3);">📌 @p.Condition</div>
                                    }
                                </td>
                                <td style="font-size:.78rem;color:var(--ns-ink3);max-width:200px;">
                                    @(p.Description ?? "—")
                                </td>
                                <td style="font-family:'Kanit',sans-serif;font-weight:700;">
                                    @(p.DiscountType switch {
                                        "percent"   => $"ลด {p.Value}%",
                                        "fixed"     => $"ลด ฿{p.Value:N0}",
                                        "free_hour" => $"แถม {p.Value} ชม.",
                                        _           => p.Value.ToString()
                                    })
                                </td>
                                <td style="font-size:.78rem;">
                                    @p.StartDate.ToString("dd/MM/yy") – @p.EndDate.ToString("dd/MM/yy")
                                </td>
                                <td style="font-size:.82rem;">
                                    @(p.UsedCount ?? 0) / @(p.UsageLimit?.ToString() ?? "∞")
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="tag tag-p">หมดอายุ</span>
                                    }
                                    else if (p.IsActive ?? false)
                                    {
                                        <span class="tag tag-c">Active</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-x">ปิด</span>
                                    }
                                </td>
                                <td style="font-size:.78rem;">@p.CreatedByNavigation.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
