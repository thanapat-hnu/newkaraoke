@* Views/Staff/RoomEdit.cshtml — แก้ไขห้อง
   ตรงกับ Room model: RoomName, Size, PricePerHour
*@
@model newkaraoke.ViewModels.RoomForm
@{
    Layout = "_StaffLayout";
    ViewBag.Title = "แก้ไขห้อง";
    ViewBag.ActiveNav = "rooms";
}

<div class="p-4" style="position:relative;z-index:1;">

    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="RoomManagement"
           style="font-size:.78rem;color:var(--ns-ink3);text-decoration:none;">
            ← จัดการห้อง
        </a>
    </div>
    <div class="pg-ttl">แก้ไขห้อง</div>
    <p class="pg-sub mb-4">แก้ไขข้อมูลห้อง ID: <strong>@ViewBag.RoomId</strong></p>

    <div class="row">

        <!-- FORM -->
        <div class="col-lg-7">
            <div class="tc">
                <div class="th">
                    <div class="th-ttl">ข้อมูลห้อง</div>
                </div>
                <div class="p-4">

                    @* POST ไป RoomEdit พร้อมส่ง id ไปด้วย *@
                    <form asp-action="RoomEdit" asp-route-id="@ViewBag.RoomId" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <div class="row g-3">

                            <div class="col-12">
                                <label asp-for="RoomName" class="form-label">
                                    ชื่อห้อง <span style="color:var(--ns-red);">*</span>
                                </label>
                                <input asp-for="RoomName"
                                       class="form-control"
                                       placeholder="เช่น Galaxy S, Neon M">
                                <span asp-validation-for="RoomName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Size" class="form-label">
                                    ความจุสูงสุด (คน) <span style="color:var(--ns-red);">*</span>
                                </label>
                                <input asp-for="Size"
                                       class="form-control"
                                       type="number"
                                       min="1" max="50"
                                       placeholder="8">
                                <span asp-validation-for="Size" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PricePerHour" class="form-label">
                                    ราคา/ชั่วโมง (฿) <span style="color:var(--ns-red);">*</span>
                                </label>
                                <input asp-for="PricePerHour"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       placeholder="590">
                                <span asp-validation-for="PricePerHour" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-dark px-4">บันทึกการแก้ไข</button>
                            <a asp-action="RoomManagement"
                               class="btn btn-outline-secondary px-4">ยกเลิก</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- PREVIEW -->
        <div class="col-lg-5">
            <div class="th-ttl mb-3">ตัวอย่าง Card</div>
            <div style="border:1px solid var(--ns-border);border-radius:4px;overflow:hidden;">
                <div class="rm-card">
                    <div class="rm-card-top">
                        <div class="rm-emoji">🎤</div>
                        <span class="rm-status-badge rm-st-active">เปิดอยู่</span>
                    </div>
                    <div class="rm-name" id="previewName">@Model.RoomName</div>
                    <div class="rm-meta" id="previewMeta">≤@Model.Size คน</div>
                    <div class="rm-price" id="previewPrice">
                        ฿@Model.PricePerHour.ToString("N0")<span style="font-size:.7rem;font-weight:400;color:var(--ns-ink3);">/ชม.</span>
                    </div>
                </div>
            </div>

            @* สร้างเมื่อไหร่ / แก้ล่าสุดเมื่อไหร่ *@
            @if (ViewBag.CreatedAt != null)
            {
                <div class="notice info mt-3" style="font-size:.75rem;">
                    สร้างเมื่อ: <strong>@ViewBag.CreatedAt</strong><br>
                    แก้ไขล่าสุด: <strong>@ViewBag.UpdatedAt</strong>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
<script>
    const nameInput  = document.querySelector('[name="RoomName"]');
    const capInput   = document.querySelector('[name="Size"]');
    const priceInput = document.querySelector('[name="PricePerHour"]');

    function updatePreview() {
        document.getElementById('previewName').textContent =
            nameInput.value || 'ชื่อห้อง';
        document.getElementById('previewMeta').textContent =
            '≤' + (capInput.value || '0') + ' คน';
        document.getElementById('previewPrice').innerHTML =
            '฿' + (parseFloat(priceInput.value) || 0).toLocaleString() +
            '<span style="font-size:.7rem;font-weight:400;color:var(--ns-ink3);">/ชม.</span>';
    }

    [nameInput, capInput, priceInput]
        .forEach(el => el?.addEventListener('input', updatePreview));
</script>
}
