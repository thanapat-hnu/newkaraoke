@model IEnumerable<newkaraoke.Models.db.Promotion>
@{
    Layout = "_ITLayout";
    ViewBag.Title = "โปรโมชั่น";
    ViewBag.ActiveNav = "promotions";
    string currentFilter = ViewBag.Filter as string ?? "";
}

<div class="p-4" style="position:relative;z-index:1;">

    <div class="pg-ttl">โปรโมชั่น</div>
    <p class="pg-sub mb-3">สร้าง แก้ไข และจัดการโปรโมชั่น</p>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <form method="get" asp-action="Promotions" class="d-flex gap-2">
            <select class="ti" name="filter" style="width:150px;" onchange="this.form.submit()">
                @if (currentFilter == "") { <option value="" selected>ทั้งหมด</option> } else { <option value="">ทั้งหมด</option> }
                @if (currentFilter == "active") { <option value="active" selected>Active</option> } else { <option value="active">Active</option> }
                @if (currentFilter == "inactive") { <option value="inactive" selected>ปิดใช้งาน</option> } else { <option value="inactive">ปิดใช้งาน</option> }
                @if (currentFilter == "expired") { <option value="expired" selected>หมดอายุ</option> } else { <option value="expired">หมดอายุ</option> }
            </select>
        </form>
        <a asp-action="PromoCreate" class="ab" style="text-decoration:none;">+ สร้างโปรโมชั่น</a>
    </div>

    @if (!Model.Any())
    {
        <div class="tc">
            <div class="p-4 text-center text-secondary small">ยังไม่มีโปรโมชั่น</div>
        </div>
    }
    else
    {
        <div class="tc">
            <div class="table-responsive">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>ชื่อ / โค้ด</th>
                            <th>คำอธิบาย</th>
                            <th>ส่วนลด</th>
                            <th>ระยะเวลา</th>
                            <th>ใช้แล้ว</th>
                            <th>สถานะ</th>
                            <th>สร้างโดย</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var today     = DateOnly.FromDateTime(DateTime.Today);
                            var isExpired = p.EndDate < today;
                            var isOn      = (p.IsActive ?? false) && !isExpired;

                            <tr style="@(!isOn ? "opacity:.6;" : "")">
                                <td>
                                    <div style="font-family:'Kanit',sans-serif;font-weight:700;font-size:.9rem;">@p.Name</div>
                                    @if (!string.IsNullOrEmpty(p.Condition))
                                    {
                                        <div style="font-size:.7rem;color:var(--ns-ink3);">📌 @p.Condition</div>
                                    }
                                </td>
                                <td style="font-size:.78rem;color:var(--ns-ink3);max-width:200px;">@(p.Description ?? "—")</td>
                                <td style="font-family:'Kanit',sans-serif;font-weight:700;">
                                    @(p.DiscountType switch {
                                        "percent"   => $"ลด {p.Value}%",
                                        "fixed"     => $"ลด ฿{p.Value:N0}",
                                        "free_hour" => $"แถม {p.Value} ชม.",
                                        _           => p.Value.ToString()
                                    })
                                </td>
                                <td style="font-size:.78rem;">@p.StartDate.ToString("dd/MM/yy") – @p.EndDate.ToString("dd/MM/yy")</td>
                                <td style="font-size:.82rem;">@(p.UsedCount ?? 0) / @(p.UsageLimit?.ToString() ?? "∞")</td>
                                <td>
                                    @if (isExpired) { <span class="tag tag-p">หมดอายุ</span> }
                                    else if (p.IsActive ?? false) { <span class="tag tag-c">Active</span> }
                                    else { <span class="tag tag-x">ปิด</span> }
                                </td>
                                <td style="font-size:.78rem;">@p.CreatedByNavigation.Name</td>
                                <td style="white-space:nowrap;">
                                    <a asp-action="PromoEdit" asp-route-id="@p.Id"
                                       class="ab sm" style="font-size:.62rem;padding:4px 8px;text-decoration:none;">แก้ไข</a>

                                    <form asp-action="PromoToggle" method="post" style="display:inline;margin-left:3px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="ab sm"
                                                style="font-size:.62rem;padding:4px 8px;
                                                @(p.IsActive ?? false ? "background:rgba(139,96,0,.1);color:var(--ns-amber);border:1px solid rgba(139,96,0,.2);" : "background:rgba(42,122,68,.1);color:var(--ns-green);border:1px solid rgba(42,122,68,.2);")">
                                            @(p.IsActive ?? false ? "ปิด" : "เปิด")
                                        </button>
                                    </form>

                                    <form asp-action="PromoDelete" method="post" style="display:inline;margin-left:3px;"
                                          onsubmit="return confirm('ลบโปรโมชั่น @p.Name ?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="ab danger" style="font-size:.62rem;padding:4px 8px;">ลบ</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
