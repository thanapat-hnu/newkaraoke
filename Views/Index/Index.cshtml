@{
    Layout = "_IndexLayout";
}

<div>
    <!-- ═══════════════════════════════
     S0: LANDING
════════════════════════════════ -->
    <div id="scroller">
        <section class="sec" id="s0">
            <div class="s0-inner" style="padding-top:56px;">
                <div class="s0-left">
                    <div class="eyebrow fade-in">เปิดทุกวัน 14:00 – 02:00 น.</div>
                    <h1 class="s0-h1 fade-in fade-in-d1">
                        <span>ร้อง</span>
                        <span class="outline">สนุก.</span>
                    </h1>
                    <p class="s0-desc fade-in fade-in-d2">คาราโอเกะพรีเมียมกลางใจเมือง เพลงกว่า 50,000 เพลง
                        ห้องหลากหลายขนาด รองรับตั้งแต่คู่จนถึงปาร์ตี้ใหญ่</p>
                        <button class="s0-cta fade-in fade-in-d3" onclick="goBooking()">จองห้องเลย →</button>
                    </div>
                    <div class="s0-right fade-in fade-in-d2">
                        <div class="stat-row">
                            <div class="stat-l">ห้องคาราโอเกะ</div>
                            <div class="stat-n">18</div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-l">เพลงในระบบ</div>
                            <div class="stat-n">50K+</div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-l">คะแนนรีวิว</div>
                            <div class="stat-n">4.9★</div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-l">ลูกค้าต่อเดือน</div>
                            <div class="stat-n">2,400</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════
     S1: ABOUT / VIBE
════════════════════════════════ -->
            <section class="sec" id="s1">
                <div class="s1-inner" style="padding-top:56px;">
                    <div>
                        <div class="s1-label fade-in">เกี่ยวกับเรา</div>
                        <h2 class="s1-h2 fade-in fade-in-d1">
                            <span
                            style="-webkit-text-stroke:1.5px rgba(242,240,235,.3);color:transparent;">พื้นที่</span><br>
                            สำหรับ<br>ทุกคน
                        </h2>
                        <p class="s1-desc fade-in fade-in-d2">Neon Star เปิดมาตั้งแต่ 2018
                            ด้วยความเชื่อว่าคาราโอเกะคือสถานที่ปลดปล่อยตัวเอง ไม่ว่าจะเสียงดีหรือไม่
                            ทุกคนสมควรมีช่วงเวลาที่ดีกับเพื่อนๆ ครอบครัว หรือแม้แต่คนเดียว</p>
                        </div>
                        <div class="s1-features fade-in fade-in-d1">
                            <div class="feat">
                                <div class="feat-icon">🎤</div>
                                <div>
                                    <div class="feat-name">ไมโครโฟนพรีเมียม</div>
                                    <div class="feat-sub">Shure & Sennheiser ในทุกห้อง</div>
                                </div>
                            </div>
                            <div class="feat">
                                <div class="feat-icon">📺</div>
                                <div>
                                    <div class="feat-name">จอ 4K Ultra HD</div>
                                    <div class="feat-sub">ตั้งแต่ 55" ถึง 100" ขึ้นกับห้อง</div>
                                </div>
                            </div>
                            <div class="feat">
                                <div class="feat-icon">🎵</div>
                                <div>
                                    <div class="feat-name">เพลงใหม่ทุกสัปดาห์</div>
                                    <div class="feat-sub">ไทย อังกฤษ เกาหลี ญี่ปุ่น จีน</div>
                                </div>
                            </div>
                            <div class="feat">
                                <div class="feat-icon">🍱</div>
                                <div>
                                    <div class="feat-name">อาหาร & เครื่องดื่ม</div>
                                    <div class="feat-sub">เมนูครบ สั่งได้ตลอดเวลาที่จอง</div>
                                </div>
                            </div>
                            <div class="feat">
                                <div class="feat-icon">🅿️</div>
                                <div>
                                    <div class="feat-name">ที่จอดรถฟรี</div>
                                    <div class="feat-sub">รองรับ 200 คัน ในอาคาร</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ═══════════════════════════════
     S2: ROOMS
════════════════════════════════ -->
                <section class="sec" id="s2">
                    <div class="s2-inner" style="padding-top:56px;">
                        <div class="sec-label fade-in">ห้องของเรา</div>
                        <h2 class="s2-h2 fade-in fade-in-d1">เลือกห้องที่ใช่</h2>
                        <div class="rooms-row fade-in fade-in-d2">
                            <div class="room-card">
                                <div class="rc-num">01</div>
                                <div class="rc-emoji">🎤</div>
                                <div class="rc-name">Galaxy S</div>
                                <div class="rc-cap">ห้องเล็ก · 2–4 คน</div>
                                <div class="rc-price">฿390<span>/ชม.</span></div>
                            </div>
                            <div class="room-card">
                                <div class="rc-num">02</div>
                                <div class="rc-emoji">🎵</div>
                                <div class="rc-name">Neon M</div>
                                <div class="rc-cap">ห้องกลาง · 4–8 คน</div>
                                <div class="rc-price">฿590<span>/ชม.</span></div>
                            </div>
                            <div class="room-card">
                                <div class="rc-num">03</div>
                                <div class="rc-emoji">🎶</div>
                                <div class="rc-name">Cyber M</div>
                                <div class="rc-cap">ห้องกลาง · 4–8 คน</div>
                                <div class="rc-price">฿590<span>/ชม.</span></div>
                            </div>
                            <div class="room-card">
                                <div class="rc-num">04</div>
                                <div class="rc-emoji">🎸</div>
                                <div class="rc-name">Star L</div>
                                <div class="rc-cap">ห้องใหญ่ · 8–12 คน</div>
                                <div class="rc-price">฿890<span>/ชม.</span></div>
                            </div>
                            <div class="room-card">
                                <div class="rc-num">05</div>
                                <div class="rc-emoji">🎹</div>
                                <div class="rc-name">Aurora L</div>
                                <div class="rc-cap">ห้องใหญ่ · 8–12 คน</div>
                                <div class="rc-price">฿890<span>/ชม.</span></div>
                            </div>
                            <div class="room-card">
                                <div class="rc-num">06</div>
                                <div class="rc-emoji">🎺</div>
                                <div class="rc-name">VIP Galaxy</div>
                                <div class="rc-cap">VIP Suite · 10–20 คน</div>
                                <div class="rc-price">฿1,990<span>/ชม.</span></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ═══════════════════════════════
     S3: BOOKING
════════════════════════════════ -->
                <section class="sec" id="s3">
                    <div class="s3-inner">
                        <div class="sec-label">จองห้อง</div>
                        <div
                            style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.5rem;">
                            <h2
                                style="font-family:'Kanit',sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);font-weight:900;letter-spacing:-1px;">
                                จองในไม่กี่ขั้น</h2>
                                <div id="bookingLoginNudge" style="font-size:.78rem;color:var(--ink3);">ต้องการจอง? <a
                                    onclick="openAuth()"
                                    style="color:var(--ink);text-decoration:underline;cursor:pointer;font-weight:600;">เข้าสู่ระบบ</a>
                                </div>
                            </div>

                            <div class="steps-wrap">

                                <!-- STEP 1: DATE -->
                                <div class="step active" id="step1">
                                    <div class="step-head" onclick="toggleStep(1)">
                                        <div class="step-num" id="sn1">1</div>
                                        <div class="step-head-text">
                                            <div class="step-title">เลือกวันที่</div>
                                            <div class="step-val" id="sv1">จองล่วงหน้าได้สูงสุด 7 วัน</div>
                                        </div>
                                        <span class="step-chevron" id="sc1">▼</span>
                                    </div>
                                    <div class="step-body">
                                        <div class="cal-hdr">
                                            <button class="cal-nav" onclick="prevMonth();event.stopPropagation()">‹</button>
                                            <div class="cal-month" id="calMonth"></div>
                                            <button class="cal-nav" onclick="nextMonth();event.stopPropagation()">›</button>
                                        </div>
                                        <div class="cal-grid" id="calGrid"></div>
                                        <div style="margin-top:.75rem;font-size:.72rem;color:var(--ink3);">จองล่วงหน้าได้สูงสุด 7
                                            วัน · วันที่เป็นสีจางจองไม่ได้</div>
                                            <button class="step-confirm-btn" id="confirmStep1" disabled
                                                    onclick="confirmStep(1)">ยืนยันวันที่ →</button>
                                        </div>
                                    </div>

                                    <!-- STEP 2: PEOPLE -->
                                    <div class="step locked" id="step2">
                                        <div class="step-head" onclick="toggleStep(2)">
                                            <div class="step-num" id="sn2">2</div>
                                            <div class="step-head-text">
                                                <div class="step-title">จำนวนคน</div>
                                                <div class="step-val" id="sv2">เลือกวันก่อน</div>
                                            </div>
                                            <span class="step-chevron" id="sc2">▼</span>
                                        </div>
                                        <div class="step-body">
                                            <div class="ppl-picker">
                                                <button class="ppl-btn" onclick="chgPpl(-1)">−</button>
                                                <div class="ppl-num" id="pplNum">2</div>
                                                <button class="ppl-btn" onclick="chgPpl(1)">+</button>
                                                <span style="font-size:.85rem;color:var(--ink3);margin-left:.5rem;">คน</span>
                                            </div>
                                            <div class="ppl-hint">เพื่อกรองห้องที่รองรับจำนวนคนของคุณ</div>
                                            <button class="step-confirm-btn" onclick="confirmStep(2)">ยืนยันจำนวนคน →</button>
                                        </div>
                                    </div>

                                    <!-- STEP 3: ROOM (moved before time) -->
                                    <div class="step locked" id="step3">
                                        <div class="step-head" onclick="toggleStep(3)">
                                            <div class="step-num" id="sn3">3</div>
                                            <div class="step-head-text">
                                                <div class="step-title">เลือกห้อง</div>
                                                <div class="step-val" id="sv3">เลือกจำนวนคนก่อน</div>
                                            </div>
                                            <span class="step-chevron" id="sc3">▼</span>
                                        </div>
                                        <div class="step-body">
                                            <div class="room-cards" id="roomCards"></div>
                                            <button class="step-confirm-btn" id="confirmStep3" disabled
                                                    onclick="confirmStep(3)">ยืนยันห้อง →</button>
                                        </div>
                                    </div>

                                    <!-- STEP 4: TIME (timeline drag) -->
                                    <div class="step locked" id="step4">
                                        <div class="step-head" onclick="toggleStep(4)">
                                            <div class="step-num" id="sn4">4</div>
                                            <div class="step-head-text">
                                                <div class="step-title">ช่วงเวลา — ลากเพื่อเลือก</div>
                                                <div class="step-val" id="sv4">เลือกห้องก่อน</div>
                                            </div>
                                            <span class="step-chevron" id="sc4">▼</span>
                                        </div>
                                        <div class="step-body">
                                            <div
                                                style="font-size:.72rem;color:var(--ink3);margin-bottom:.75rem;display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;">
                                                <span>ลากบน timeline เลือกช่วงเวลา · ทุก 15 นาที · ขั้นต่ำ 1 ชั่วโมง</span>
                                                <span style="display:flex;gap:.5rem;align-items:center;">
                                                    <span
                                                    style="display:inline-block;width:10px;height:10px;background:var(--ink2);border-radius:1px;"></span>จองแล้ว
                                                </span>
                                            </div>
                                            <div class="tl-wrap" id="tlWrap"></div>
                                            <div id="tlMinWarning"
                                                 style="display:none;font-size:.75rem;color:#b03030;margin-top:.5rem;">⚠
                                                กรุณาเลือกอย่างน้อย 1 ชั่วโมง (4 ช่อง)</div>
                                                <button class="step-confirm-btn" id="confirmStep4" disabled
                                                        onclick="confirmStep(4)">ยืนยันเวลา →</button>
                                            </div>
                                        </div>

                                        <!-- STEP 5: REVIEW + PAY -->
                                        <div class="step locked" id="step5">
                                            <div class="step-head" onclick="toggleStep(5)">
                                                <div class="step-num" id="sn5">5</div>
                                                <div class="step-head-text">
                                                    <div class="step-title">ตรวจสอบและชำระเงิน</div>
                                                    <div class="step-val" id="sv5">รอข้อมูลการจอง</div>
                                                </div>
                                                <span class="step-chevron" id="sc5">▼</span>
                                            </div>
                                            <div class="step-body">
                                                <div class="sum-box">
                                                    <div class="s-row"><span class="sl">วันที่</span><span id="sumDate">—</span></div>
                                                    <div class="s-row"><span class="sl">เวลา</span><span id="sumTime">—</span></div>
                                                    <div class="s-row"><span class="sl">ระยะเวลา</span><span id="sumDur">—</span></div>
                                                    <div class="s-row"><span class="sl">จำนวนคน</span><span id="sumPpl">—</span></div>
                                                    <div class="s-row"><span class="sl">ห้อง</span><span id="sumRoom">—</span></div>
                                                    <div class="s-row" id="discountRow" style="display:none;"><span
                                                        class="sl">ส่วนลด</span><span id="sumDiscount"
                                                                                      style="color:#2a7a44;font-weight:600;">—</span></div>
                                                        <div class="s-row stot"><span class="sl">ยอดรวม</span><span id="sumTotal">—</span></div>
                                                    </div>

                                                    <!-- PAYMENT METHOD -->
                                                    <div style="margin-bottom:1rem;">
                                                        <div
                                                            style="font-family:'Kanit',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--ink3);margin-bottom:.6rem;">
                                                            ช่องทางชำระเงิน</div>
                                                            <div class="pay-methods">
                                                                <div class="pay-method active" id="pm-counter" onclick="selectPay('counter')">
                                                                    <div class="pay-icon">🏦</div>
                                                                    <div class="pay-name">ชำระที่เคาน์เตอร์</div>
                                                                    <div class="pay-sub">จ่ายเมื่อมาถึงร้าน</div>
                                                                </div>
                                                                <div class="pay-method" id="pm-promptpay" onclick="selectPay('promptpay')">
                                                                    <div class="pay-icon">📱</div>
                                                                    <div class="pay-name">PromptPay</div>
                                                                    <div class="pay-sub">สแกน QR โอนจ่ายเลย</div>
                                                                </div>
                                                                <div class="pay-method" id="pm-card" onclick="selectPay('card')">
                                                                    <div class="pay-icon">💳</div>
                                                                    <div class="pay-name">บัตรเครดิต/เดบิต</div>
                                                                    <div class="pay-sub">Visa, Mastercard, JCB</div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- PROMO CODE — อยู่หลังเลือกวิธีชำระ ก่อนยืนยัน -->
                                                        <div
                                                            style="margin-bottom:1rem;background:var(--surface);border:1px solid var(--border);border-radius:3px;padding:1rem 1.1rem;">
                                                            <div
                                                                style="font-family:'Kanit',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--ink3);margin-bottom:.6rem;">
                                                                รหัสโปรโมชั่น (ถ้ามี)</div>
                                                                <div style="display:flex;gap:6px;align-items:center;">
                                                                    <input type="text" id="promoInput" placeholder="เช่น NEON20, VIPFREE" maxlength="20"
                                                                           style="flex:1;background:var(--bg);border:1px solid var(--border-md);border-radius:3px;color:var(--ink);padding:10px 13px;font-family:'Kanit',sans-serif;font-size:.88rem;font-weight:600;letter-spacing:1px;outline:none;text-transform:uppercase;transition:border-color .2s;"
                                                                           oninput="this.value=this.value.toUpperCase();clearPromo()"
                                                                           onfocus="this.style.borderColor='var(--ink)'"
                                                                           onblur="this.style.borderColor='var(--border-md)'"
                                                                           onkeydown="if(event.key==='Enter')applyPromo()" />
                                                                    <button onclick="applyPromo()"
                                                                            style="background:var(--ink);border:none;border-radius:3px;color:var(--bg);font-family:'Kanit',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:10px 16px;cursor:pointer;white-space:nowrap;flex-shrink:0;">ใช้โค้ด</button>
                                                                </div>
                                                                <div id="promoMsg"
                                                                     style="font-size:.78rem;margin-top:.5rem;min-height:18px;line-height:1.5;"></div>
                                                            </div>

                                                            <!-- PAYMENT SIM -->
                                                            <div id="paySimCounter" class="pay-sim">
                                                                <div class="pay-sim-note">ชำระเงินเมื่อมาถึงร้าน ไม่ต้องชำระล่วงหน้า</div>
                                                                <button class="book-btn" onclick="doBook()">ยืนยันการจอง</button>
                                                            </div>

                                                            <div id="paySimPromptpay" class="pay-sim" style="display:none;">
                                                                <div class="pay-sim-qr">
                                                                    <div class="qr-box">
                                                                        <div style="font-size:2.5rem;margin-bottom:.5rem;">▪▫▪▫▪<br>▫▪▫▪▫<br>▪▫▪▫▪</div>
                                                                        <div style="font-size:.7rem;color:var(--ink3);letter-spacing:1px;">QR PROMPTPAY
                                                                            (จำลอง)</div>
                                                                        </div>
                                                                        <div class="pay-sim-note">สแกน QR Code ด้วย Mobile Banking แล้วกด "ยืนยันการชำระ"
                                                                        </div>
                                                                    </div>
                                                                    <button class="book-btn pay-btn-pp" onclick="simPay('promptpay')">✓ ยืนยันการชำระเงิน
                                                                        (จำลอง)</button>
                                                                    </div>

                                                                    <div id="paySimCard" class="pay-sim" style="display:none;">
                                                                        <div class="card-form">
                                                                            <div class="card-preview" id="cardPreview">
                                                                                <div class="card-chip">▬</div>
                                                                                <div class="card-num" id="cardNumDisplay">•••• •••• •••• ••••</div>
                                                                                <div class="card-bottom">
                                                                                    <div>
                                                                                        <div style="font-size:.55rem;opacity:.6;">CARD HOLDER</div>
                                                                                        <div class="card-name-display" id="cardNameDisplay">YOUR NAME</div>
                                                                                    </div>
                                                                                    <div>
                                                                                        <div style="font-size:.55rem;opacity:.6;">EXPIRES</div>
                                                                                        <div id="cardExpDisplay">MM/YY</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="card-inputs">
                                                                                <div class="fg"><label>หมายเลขบัตร</label><input type="text" id="cardNum"
                                                                                                                                     maxlength="19" placeholder="0000 0000 0000 0000"
                                                                                                                                     oninput="fmtCard(this)" /></div>
                                                                                    <div class="fg"><label>ชื่อบนบัตร</label><input type="text" id="cardName"
                                                                                                                                        placeholder="FULL NAME"
                                                                                                                                        oninput="document.getElementById('cardNameDisplay').textContent=this.value.toUpperCase()||'YOUR NAME'" />
                                                                                    </div>
                                                                                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem;">
                                                                                        <div class="fg"><label>หมดอายุ</label><input type="text" id="cardExp"
                                                                                                                                         maxlength="5" placeholder="MM/YY" oninput="fmtExp(this)" /></div>
                                                                                            <div class="fg"><label>CVV</label><input type="text" id="cardCvv"
                                                                                                                                         maxlength="3" placeholder="•••" /></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <button class="book-btn pay-btn-card" onclick="simPay('card')">ชำระเงิน <span
                                                                                        id="cardPayAmt"></span> (จำลอง)</button>
                                                                                    </div>

                                                                                </div>
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                </section>

                                                                <!-- ═══════════════════════════════
     S4: MY BOOKINGS
════════════════════════════════ -->
                                                                <section class="sec" id="s4">
                                                                    <div class="s4-inner">
                                                                        <div class="sec-label">การจองของฉัน</div>
                                                                        <h2
                                                                            style="font-family:'Kanit',sans-serif;font-size:clamp(1.8rem,3vw,2.8rem);font-weight:900;letter-spacing:-1px;margin-bottom:1.5rem;">
                                                                            ประวัติการจอง</h2>
                                                                            <div class="bk-grid" id="bkGrid"></div>
                                                                        </div>
                                                                    </section>

                                                                </div><!-- end scroller -->

                                                                <!-- AUTH MODAL -->
                                                                <div id="authOverlay" style="display:none;">
                                                                    <div class="auth-card">
                                                                        <div style="display:flex;align-items:center;border-bottom:1px solid var(--border);">
                                                                            <div class="auth-tabs" style="border-bottom:none;flex:1;">
                                                                                <button class="auth-tab active" onclick="switchTab('login')">เข้าสู่ระบบ</button>
                                                                                <button class="auth-tab" onclick="switchTab('register')">สมัครสมาชิก</button>
                                                                            </div>
                                                                            <button onclick="closeAuth()"
