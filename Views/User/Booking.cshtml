@model newkaraoke.ViewModels.BookingPageViewModel
@{
    Layout = "_IndexLayout";
    ViewBag.Title = "จองห้อง";
    var userId = Context.Session.GetString("UserId");
}

@if (userId == null)
{
    <div class="d-flex align-items-center justify-content-center" style="min-height:calc(100vh - 56px);">
        <div class="text-center p-4">
            <h2 class="font-kanit fw-black mb-2">กรุณาเข้าสู่ระบบ</h2>
            <p class="text-secondary mb-4">เพื่อจองห้องคาราโอเกะ</p>
            <a asp-controller="User" asp-action="Auth" class="btn btn-dark px-4">เข้าสู่ระบบ →</a>
        </div>
    </div>
}
else
{
<div class="container" style="max-width:860px;padding:2.5rem 1.5rem 5rem;position:relative;z-index:1;">

    <div class="sec-label">จองห้อง</div>
    <h1 class="font-kanit fw-black mb-4"
        style="font-size:clamp(1.6rem,3vw,2.4rem);letter-spacing:-1px;">จองในไม่กี่ขั้น</h1>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger py-2 small mb-3">@Model.Error</div>
    }

    <form asp-action="BookingSubmit" method="post" id="bookingForm">
        @Html.AntiForgeryToken()

        <!-- ── STEP 1: DATE (JS Calendar) ── -->
        <div class="step-item active" id="step1">
            <div class="step-btn" onclick="toggleStep(1)">
                <div class="step-num-badge">1</div>
                <div class="flex-grow-1">
                    <div class="font-kanit fw-bold" style="font-size:.88rem;">เลือกวันที่</div>
                    <div class="step-val" id="sv1">
                        @(Model.SelectedDate != null
                            ? DateTime.Parse(Model.SelectedDate).ToString("dd/MM/yyyy")
                            : "จองล่วงหน้าได้สูงสุด 7 วัน")
                    </div>
                </div>
                <span class="step-chevron">▼</span>
            </div>
            <div class="step-body">
                <div class="d-flex align-items-center justify-content-between mb-3 pt-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="prevMonth()">‹</button>
                    <span class="font-kanit fw-bold" id="calMonth"></span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="nextMonth()">›</button>
                </div>
                <div id="calGrid"></div>
                <p class="text-secondary mt-2 mb-0" style="font-size:.72rem;">
                    จองล่วงหน้าได้สูงสุด 7 วัน · วันที่เป็นสีจางจองไม่ได้
                </p>
                @* hidden input เก็บค่าวันที่ที่เลือก *@
                <input type="hidden" name="Date" id="inputDate" value="@Model.SelectedDate">
                <button type="button" class="btn btn-dark w-100 mt-3" id="confirmStep1"
                        @(Model.SelectedDate != null ? "" : "disabled")
                        onclick="confirmStep(1)">
                    ยืนยันวันที่ →
                </button>
            </div>
        </div>

        <!-- ── STEP 2: PEOPLE (input number ล้วน ไม่ต้องใช้ JS) ── -->
        <div class="step-item @(Model.SelectedDate != null ? "" : "locked")" id="step2">
            <div class="step-btn" onclick="toggleStep(2)">
                <div class="step-num-badge">2</div>
                <div class="flex-grow-1">
                    <div class="font-kanit fw-bold" style="font-size:.88rem;">จำนวนคน</div>
                    <div class="step-val">@Model.People คน</div>
                </div>
                <span class="step-chevron">▼</span>
            </div>
            <div class="step-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <label class="form-label mb-0">จำนวนคน</label>
                    <input type="number" class="form-control" name="People"
                           value="@Model.People" min="1" max="20"
                           style="width:100px;"
                           onchange="updatePeopleStep(this.value)">
                </div>
                <p class="text-secondary mb-3" style="font-size:.78rem;">
                    เพื่อกรองห้องที่รองรับจำนวนคนของคุณ
                </p>
                <button type="button" class="btn btn-dark w-100" onclick="confirmStep(2)">
                    ยืนยันจำนวนคน →
                </button>
            </div>
        </div>

        <!-- ── STEP 3: ROOM (Razor foreach) ── -->
        <div class="step-item @(Model.SelectedDate != null ? "" : "locked")" id="step3">
            <div class="step-btn" onclick="toggleStep(3)">
                <div class="step-num-badge">3</div>
                <div class="flex-grow-1">
                    <div class="font-kanit fw-bold" style="font-size:.88rem;">เลือกห้อง</div>
                    <div class="step-val" id="sv3">
                        @{
                            var selRoom = Model.Rooms.FirstOrDefault(r => r.Id == Model.SelectedRoomId);
                        }
                        @(selRoom != null ? selRoom.RoomName : "เลือกห้องที่ต้องการ")
                    </div>
                </div>
                <span class="step-chevron">▼</span>
            </div>
            <div class="step-body">
                <div class="row g-3 mt-1" id="roomGrid">
                    @foreach (var r in Model.Rooms)
                    {
                        var isSelected = r.Id == Model.SelectedRoomId;
                        <div class="col-12 col-sm-6" data-room-size="@r.Size" data-room-id="@r.Id">
                            <label style="cursor:pointer;width:100%;display:block;">
                                <input type="radio" name="RoomId" value="@r.Id"
                                       class="d-none"
                                       @(isSelected ? "checked" : "")
                                       onchange="pickRoom(@r.Id, '@r.RoomName')">
                                <div class="bk-room-card @(isSelected ? "bk-room-selected" : "")" id="roomCard_@r.Id">
                                    @* รูปห้อง — ถ้าไม่มีใช้ placeholder gradient *@
                                    <div class="bk-room-img">
                                        @if (!string.IsNullOrEmpty(r.ImageUrl))
                                        {
                                            <img src="@r.ImageUrl" alt="@r.RoomName">
                                        }
                                        else
                                        {
                                            @* Placeholder ตามขนาดห้อง *@
                                            var gradIdx = r.Id % 4;
                                            var grads = new[] {
                                                "linear-gradient(135deg,#1C1C1A 0%,#3A3A36 100%)",
                                                "linear-gradient(135deg,#2a3a2a 0%,#1C1C1A 100%)",
                                                "linear-gradient(135deg,#1a1a2e 0%,#16213e 100%)",
                                                "linear-gradient(135deg,#2d1b1b 0%,#1C1C1A 100%)"
                                            };
                                            <div style="width:100%;height:100%;background:@grads[gradIdx];
                                                display:flex;align-items:center;justify-content:center;flex-direction:column;gap:6px;">
                                                <span style="font-size:2rem;">🎤</span>
                                                <span style="font-family:'Kanit',sans-serif;font-size:.65rem;
                                                    color:rgba(242,240,235,.3);letter-spacing:2px;text-transform:uppercase;">
                                                    @(r.Size <= 4 ? "Small" : r.Size <= 8 ? "Medium" : r.Size <= 12 ? "Large" : "VIP")
                                                </span>
                                            </div>
                                        }
                                        @* Badge เต็ม — ถูกลบออกแล้ว *@
                                    </div>
                                    <div class="bk-room-info">
                                        <div class="bk-room-name">@r.RoomName</div>
                                        <div class="bk-room-cap">≤@r.Size คน</div>
                                        <div class="bk-room-price">
                                            ฿@r.PricePerHour.ToString("N0")
                                            <span class="bk-room-unit">/ชม.</span>
                                        </div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    }
                    <div id="noRoomMsg" class="col-12 text-secondary small py-2" style="display:none;">
                        ไม่มีห้องที่รองรับจำนวนคนนี้
                    </div>
                </div>
                <button type="button" class="btn btn-dark w-100 mt-3" id="confirmStep3"
                        @(Model.SelectedRoomId != null ? "" : "disabled")
                        onclick="confirmStep(3)">
                    ยืนยันห้อง →
                </button>
            </div>
        </div>

        <!-- ── STEP 4: TIME (JS Timeline) ── -->
        <div class="step-item @(Model.SelectedRoomId != null ? "" : "locked")" id="step4">
            <div class="step-btn" onclick="toggleStep(4)">
                <div class="step-num-badge">4</div>
                <div class="flex-grow-1">
                    <div class="font-kanit fw-bold" style="font-size:.88rem;">ช่วงเวลา — ลากเพื่อเลือก</div>
                    <div class="step-val" id="sv4">
                        @(Model.SelectedStart != null
                            ? $"{Model.SelectedStart} – {Model.SelectedEnd}"
                            : "เลือกช่วงเวลา")
                    </div>
                </div>
                <span class="step-chevron">▼</span>
            </div>
            <div class="step-body">
                <p class="text-secondary mb-3" style="font-size:.72rem;">
                    ลากบน timeline เลือกช่วงเวลา · ทุก 15 นาที · ขั้นต่ำ 1 ชั่วโมง
                </p>
                <div id="tlWrap"></div>
                <div id="tlMinWarning" class="text-danger mt-2 small d-none">
                    ⚠ กรุณาเลือกอย่างน้อย 1 ชั่วโมง (4 ช่อง)
                </div>
                @* hidden inputs เก็บเวลา *@
                <input type="hidden" name="StartTime" id="inputStart" value="@Model.SelectedStart">
                <input type="hidden" name="EndTime"   id="inputEnd"   value="@Model.SelectedEnd">
                <button type="button" class="btn btn-dark w-100 mt-3" id="confirmStep4"
                        @(Model.SelectedStart != null ? "" : "disabled")
                        onclick="submitBooking()">
                    ดูสรุปและชำระเงิน →
                </button>
            </div>
        </div>

    </form>
</div>

@section Scripts {
<style>
/* ── Room Cards ── */
.bk-room-card {
    border: 1.5px solid var(--ns-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--ns-sf);
    transition: border-color .15s, box-shadow .15s;
    position: relative;
}
.bk-room-card:hover {
    border-color: var(--ns-border-md);
    box-shadow: 0 2px 12px rgba(28,28,26,.08);
}
.bk-room-selected {
    border-color: var(--ns-ink) !important;
    box-shadow: 0 0 0 2px var(--ns-ink) !important;
}
.bk-room-img {
    width: 100%;
    height: 130px;
    overflow: hidden;
    position: relative;
    background: var(--ns-bg3);
}
.bk-room-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.bk-room-info {
    padding: .85rem 1rem .9rem;
}
.bk-room-name {
    font-family: 'Kanit', sans-serif;
    font-size: .95rem;
    font-weight: 700;
    color: var(--ns-ink);
    margin-bottom: 2px;
}
.bk-room-cap {
    font-size: .75rem;
    color: var(--ns-ink3);
    margin-bottom: .35rem;
}
.bk-room-price {
    font-family: 'Kanit', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--ns-ink);
}
.bk-room-unit {
    font-size: .68rem;
    font-weight: 400;
    color: var(--ns-ink3);
}
</style>
<script src="~/js/Booking.js"></script>
<script>
const ROOMS_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rooms));
</script>
}
}
