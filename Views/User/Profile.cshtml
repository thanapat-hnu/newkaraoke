@model newkaraoke.ViewModels.ProfileViewModel
@{
    Layout = "_IndexLayout";
    ViewBag.Title = "โปรไฟล์";
}

<div class="container py-5" style="max-width:900px;position:relative;z-index:1;">

    @if (TempData["Toast"] != null)
    {
        <div class="alert alert-success py-2 small mb-4">@TempData["Toast"]</div>
    }

    <!-- PROFILE HERO -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pb-4 mb-4 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar">
                @Model.Name[0].ToString().ToUpper()
            </div>
            <div>
                <div style="font-family:'Kanit',sans-serif;font-size:1.4rem;font-weight:900;letter-spacing:-.5px;">
                    @Model.Name
                </div>
                <div class="text-secondary small">@Model.Email</div>
                <div class="text-secondary" style="font-size:.75rem;">
                    สมาชิกตั้งแต่ @Model.JoinedAt
                </div>
            </div>
        </div>
        <a asp-action="ProfileEdit" class="btn btn-outline-secondary btn-sm">
            แก้ไขโปรไฟล์
        </a>
    </div>

    <!-- STATS -->
    <div class="row g-px mb-4"
         style="--bs-gutter-x:1px;--bs-gutter-y:1px;background:var(--ns-border);border:1px solid var(--ns-border);border-radius:4px;overflow:hidden;">
        <div class="col-4">
            <div class="p-3">
                <div class="text-uppercase text-secondary mb-1"
                     style="font-size:.6rem;letter-spacing:2px;font-family:'Kanit',sans-serif;font-weight:700;">
                    จองทั้งหมด
                </div>
                <div style="font-family:'Kanit',sans-serif;font-size:1.75rem;font-weight:900;">
                    @Model.TotalBookings
                </div>
                <div class="text-secondary" style="font-size:.7rem;">ครั้ง</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3">
                <div class="text-uppercase text-secondary mb-1"
                     style="font-size:.6rem;letter-spacing:2px;font-family:'Kanit',sans-serif;font-weight:700;">
                    ชั่วโมงรวม
                </div>
                <div style="font-family:'Kanit',sans-serif;font-size:1.75rem;font-weight:900;">
                    @Model.TotalHours.ToString("N1")
                </div>
                <div class="text-secondary" style="font-size:.7rem;">ชั่วโมง</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3">
                <div class="text-uppercase text-secondary mb-1"
                     style="font-size:.6rem;letter-spacing:2px;font-family:'Kanit',sans-serif;font-weight:700;">
                    ยอดใช้จ่าย
                </div>
                <div style="font-family:'Kanit',sans-serif;font-size:1.75rem;font-weight:900;">
                    ฿@Model.TotalSpend.ToString("N0")
                </div>
                <div class="text-secondary" style="font-size:.7rem;">บาท</div>
            </div>
        </div>
    </div>

    <!-- RECENT BOOKINGS -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div style="font-family:'Kanit',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--ns-ink3);">
            ประวัติการจองล่าสุด
        </div>
        <a asp-action="Bookings" class="text-secondary text-decoration-none"
           style="font-size:.78rem;">ดูทั้งหมด →</a>
    </div>

    @if (!Model.RecentBookings.Any())
    {
        <div class="tc">
            <div class="p-4 text-center text-secondary small">ยังไม่มีประวัติการจอง</div>
        </div>
    }
    else
    {
        <div class="tc">
            <div class="table-responsive">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>รหัสจอง</th>
                            <th>ห้อง</th>
                            <th>วันที่</th>
                            <th>เวลา</th>
                            <th>ยอด</th>
                            <th>สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td style="font-family:'Kanit',sans-serif;font-size:.65rem;color:var(--ns-ink3);">
                                    @b.Code
                                </td>
                                <td style="font-size:.82rem;font-weight:600;">@b.RoomName</td>
                                <td style="font-size:.78rem;">@b.Date</td>
                                <td style="font-family:'Kanit',sans-serif;font-size:.78rem;">@b.Time</td>
                                <td style="font-family:'Kanit',sans-serif;font-weight:600;">
                                    ฿@b.TotalPrice.ToString("N0")
                                </td>
                                <td>
                                    <span class="tag @(b.Status == "confirmed" ? "tag-c" : "tag-p")">
                                        @(b.Status == "confirmed" ? "ยืนยัน" : "รอ")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
