@model newkaraoke.ViewModels.Users
@{
    Layout = "_IndexLayout";
    var activeTab = TempData["ActiveTab"]?.ToString() ?? "login";
}

<div class="auth-page">
    <div class="card border-0 w-100" style="max-width:420px;">

        <ul class="nav auth-tabs d-flex" id="authTab" role="tablist">
            <li class="nav-item flex-fill">
                <button class="nav-link @(activeTab == "login" ? "active" : "") w-100" id="btnLogin"
                        data-bs-toggle="tab" data-bs-target="#loginPane">
                    เข้าสู่ระบบ
                </button>
            </li>
            <li class="nav-item flex-fill">
                <button class="nav-link @(activeTab == "register" ? "active" : "") w-100" id="btnRegister"
                        data-bs-toggle="tab" data-bs-target="#registerPane">
                    สมัครสมาชิก
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- LOGIN -->
            <div class="tab-pane fade @(activeTab == "login" ? "show active" : "") p-4" id="loginPane">
                <div class="auth-heading mb-1">ยินดีต้อนรับกลับ</div>
                <div class="text-secondary mb-3" style="font-size:.83rem;">เข้าสู่ระบบเพื่อจองห้องคาราโอเกะ</div>

                @if (TempData["LoginError"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@TempData["LoginError"]</div>
                }

                <form id="loginForm" class="vstack gap-3" asp-controller="User" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label">อีเมล</label>
                        <input type="email" class="form-control" id="lEmail" value="demo@demo.damo" name="Email"
                               placeholder="your@email.com">
                    </div>
                    <div>
                        <label class="form-label">รหัสผ่าน</label>
                        <input type="password" class="form-control" id="lPass" value="123456" name="Password"
                               placeholder="••••••••">
                    </div>
                    <button type="button" class="btn btn-dark w-100" onclick="doLogin()">
                        เข้าสู่ระบบ
                    </button>
                </form>

                <p class="text-center text-secondary small mt-3 mb-0">
                    ยังไม่มีบัญชี?
                    <a href="#" class="text-dark fw-semibold text-decoration-underline"
                           onclick="document.getElementById('btnRegister').click()">
                        สมัครสมาชิก
                    </a>
                </p>
            </div>

            <!-- REGISTER -->
            <div class="tab-pane fade @(activeTab == "register" ? "show active" : "") p-4" id="registerPane">
                <div class="auth-heading mb-1">สร้างบัญชีใหม่</div>
                <div class="text-secondary mb-3" style="font-size:.83rem;">สมัครฟรี เริ่มจองห้องทันที</div>

                @if (TempData["RegisterError"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@TempData["RegisterError"]</div>
                }

                <form id="registerForm" class="vstack gap-3" asp-controller="User" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label">ชื่อ-นามสกุล</label>
                        <input type="text" class="form-control" id="rName" value="demo@demo.damo" name="Name"
                               placeholder="ชื่อของคุณ">
                        <div id="NameErr" class="text-danger small d-none"></div>
                    </div>
                    <div>
                        <label class="form-label">เบอร์โทรศัพท์</label>
                        <input type="tel" class="form-control" id="rPhone" value="0123456789" name="Phone"
                               placeholder="0812345678" maxlength="10">
                        <div id="PhoneErr" class="text-danger small d-none"></div>
                    </div>
                    <div>
                        <label class="form-label">อีเมล</label>
                        <input type="email" class="form-control" id="rEmail" value="demo@demo.damo" name="Email"
                               placeholder="your@email.com">
                        <div id="EmailErr" class="text-danger small d-none"></div>
                    </div>
                    <div>
                        <label class="form-label">รหัสผ่าน (อย่างน้อย 6 ตัว)</label>
                        <input type="password" class="form-control" id="rPassword" value="123456" name="Password"
                               placeholder="••••••••">
                        <div id="PasswordErr" class="text-danger small d-none"></div>
                    </div>
                    <button type="button" class="btn btn-dark w-100" onclick="doRegister()">
                        สมัครสมาชิก
                    </button>
                </form>

                <p class="text-center text-secondary small mt-3 mb-0">
                    มีบัญชีแล้ว?
                    <a href="#" class="text-dark fw-semibold text-decoration-underline"
                           onclick="document.getElementById('btnLogin').click()">
                        เข้าสู่ระบบ
                    </a>
                </p>
            </div>

        </div>
    </div>
    @section Scripts {
        <script src="~/js/Login.js"></script>
    }
</div>

