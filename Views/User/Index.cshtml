@{
    Layout = "_IndexLayout";
    ViewBag.Title = "Neon Star Karaoke";
    var rooms        = ViewBag.Rooms        as List<newkaraoke.Models.db.Room> ?? new();
    var activePromos = ViewBag.ActivePromos as List<newkaraoke.Models.db.Promotion> ?? new();
    int roomCount    = (int)(ViewBag.RoomCount ?? rooms.Count);
    var userName     = Context.Session.GetString("UserName");
    bool isLoggedIn  = !string.IsNullOrEmpty(userName);
}

<div>
    <!-- ══ HERO ══════════════════════════════════════════════ -->
    <section class="hero-section">
        <div class="container-xl px-4 py-5">
            <div class="row align-items-center g-5">
                <div class="col-md-6">
                    <div class="eyebrow mb-4">เปิดทุกวัน 14:00 – 02:00 น.</div>
                    <h1 class="hero-h1">ร้อง<br><span class="text-outline-ink">สนุก.</span></h1>
                    <p class="text-secondary mb-4" style="font-size:.95rem;line-height:1.9;max-width:380px;">
                        คาราโอเกะพรีเมียมกลางใจเมือง เพลงกว่า 50,000 เพลง ห้องหลากหลายขนาด
                        รองรับตั้งแต่คู่จนถึงปาร์ตี้ใหญ่
                    </p>
                    @if (isLoggedIn)
                    {
                        <a href="/user/booking" class="btn btn-dark px-4 py-3" style="font-size:.85rem;">จองห้องเลย →</a>
                    }
                    else
                    {
                        <a href="/user/auth" class="btn btn-dark px-4 py-3" style="font-size:.85rem;">เข้าสู่ระบบเพื่อจอง →</a>
                    }
                </div>

                <!-- Stat Cards — ตัวเลขจาก DB จริง -->
                <div class="col-md-6">
                    <div class="list-group rounded-3" style="gap:1px;">
                        <div class="list-group-item stat-card-item d-flex justify-content-between align-items-center px-4 py-3 border-0 mb-px">
                            <span style="font-size:.75rem;color:var(--ns-ink3);">ห้องคาราโอเกะที่เปิดอยู่</span>
                            <span class="stat-n-lg">@roomCount</span>
                        </div>
                        <div class="list-group-item stat-card-item d-flex justify-content-between align-items-center px-4 py-3 border-0 mb-px">
                            <span style="font-size:.75rem;color:var(--ns-ink3);">เพลงในระบบ</span>
                            <span class="stat-n-lg">50K+</span>
                        </div>
                        <div class="list-group-item stat-card-item d-flex justify-content-between align-items-center px-4 py-3 border-0 mb-px">
                            <span style="font-size:.75rem;color:var(--ns-ink3);">คะแนนรีวิว</span>
                            <span class="stat-n-lg">4.9★</span>
                        </div>
                        <div class="list-group-item stat-card-item d-flex justify-content-between align-items-center px-4 py-3 border-0">
                            <span style="font-size:.75rem;color:var(--ns-ink3);">ลูกค้าต่อเดือน</span>
                            <span class="stat-n-lg">2,400</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* โปรโมชั่นที่ใช้งานได้ — แสดงเฉพาะเมื่อมี *@
    @if (activePromos.Any())
    {
        <section class="py-4" style="background:var(--ns-ink);position:relative;z-index:1;">
            <div class="container-xl px-4">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span style="font-family:'Kanit',sans-serif;font-size:.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(242,240,235,.3);">โปรโมชั่น</span>
                    @foreach (var p in activePromos)
                    {
                        var disc = p.DiscountType switch {
                            "percent"   => $"ลด {p.Value}%",
                            "fixed"     => $"ลด ฿{p.Value:N0}",
                            "free_hour" => $"แถม {p.Value} ชม.",
                            _           => p.Value.ToString()
                        };
                        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:3px;padding:6px 14px;display:flex;align-items:center;gap:10px;">
                            <span style="font-family:'Kanit',sans-serif;font-weight:700;color:var(--ns-bg);font-size:.9rem;">@p.Name</span>
                            <span style="font-size:.75rem;color:rgba(242,240,235,.5);">@disc</span>
                            <span style="font-size:.68rem;color:rgba(242,240,235,.3);">ถึง @p.EndDate.ToString("dd/MM/yy")</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ══ ROOMS — ดึงจาก DB จริง ══════════════════════════════ -->
    <section class="rooms-section py-5">
        <div class="container-xl px-4">
            <div class="sec-label">ห้องของเรา</div>
            <h2 class="font-kanit fw-black mb-4" style="font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-1.5px;">เลือกห้องที่ใช่</h2>

            @if (rooms.Any())
            {
                <div class="row g-0" style="border:1px solid var(--ns-border);border-radius:4px;overflow:hidden;">
                    @for (int i = 0; i < rooms.Count; i++)
                    {
                        var r = rooms[i];
                        var borderStyle = i >= 3 ? "border-top:1px solid var(--ns-border);" : "";
                        if (i % 3 != 0) borderStyle += "border-left:1px solid var(--ns-border);";
                        <div class="col-12 col-sm-6 col-lg-4" style="@borderStyle">
                            <div class="room-card-item p-4 h-100">
                                <div class="rc-num">@((i+1).ToString("D2"))</div>
                                <div class="fw-bold font-kanit mb-1">@r.RoomName</div>
                                <div class="text-secondary small mb-3">รับได้สูงสุด @r.Size คน</div>
                                <div class="rc-price-lg">
                                    ฿@r.PricePerHour.ToString("N0")<span class="fw-normal text-secondary" style="font-size:.72rem;">/ชม.</span>
                                </div>
                                @if (!string.IsNullOrEmpty(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" class="mt-3 rounded" style="width:100%;height:80px;object-fit:cover;opacity:.7;">
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="row g-0" style="border:1px solid var(--ns-border);border-radius:4px;overflow:hidden;">
                    <div class="col-12 p-5 text-center text-secondary">ยังไม่มีห้องที่เปิดให้บริการ</div>
                </div>
            }

            <div class="text-center mt-4">
                <a href="/user/booking" class="btn btn-dark px-4 py-2" style="font-size:.85rem;">จองห้องเลย →</a>
            </div>
        </div>
    </section>

    <!-- ══ ABOUT ══════════════════════════════════════════════ -->
    <section class="about-section py-6" style="padding:6rem 0;position:relative;">
        <div class="container-xl px-4" style="position:relative;z-index:1;">
            <div class="row align-items-center g-5">
                <div class="col-md-5">
                    <div class="about-label mb-3" style="font-family:'Kanit',sans-serif;font-size:.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(242,240,235,.35);">เกี่ยวกับเรา</div>
                    <h2 class="about-h2 mb-3">
                        <span class="text-outline-light">พื้นที่</span><br>สำหรับ<br>ทุกคน
                    </h2>
                    <p style="font-size:.93rem;color:rgba(242,240,235,.55);line-height:1.9;">
                        Neon Star เปิดมาตั้งแต่ 2018 ด้วยความเชื่อว่าคาราโอเกะคือสถานที่ปลดปล่อยตัวเอง
                        ไม่ว่าจะเสียงดีหรือไม่ ทุกคนสมควรมีช่วงเวลาที่ดีกับเพื่อนๆ ครอบครัว หรือแม้แต่คนเดียว
                    </p>
                </div>
                <div class="col-md-7">
                    <div class="vstack gap-1">
                        @foreach (var feat in new[] {
                            ("🎤", "ไมโครโฟนพรีเมียม", "Shure & Sennheiser ในทุกห้อง"),
                            ("📺", "จอ 4K Ultra HD", "ตั้งแต่ 55\" ถึง 100\" ขึ้นกับห้อง"),
                            ("🎵", "เพลงใหม่ทุกสัปดาห์", "ไทย อังกฤษ เกาหลี ญี่ปุ่น จีน"),
                            ("🍱", "อาหาร & เครื่องดื่ม", "เมนูครบ สั่งได้ตลอดเวลาที่จอง"),
                            ("🅿️", "ที่จอดรถฟรี", "รองรับ 200 คัน ในอาคาร")
                        })
                        {
                            <div class="feat-item d-flex align-items-center gap-3 p-3 rounded-1">
                                <span style="font-size:1.3rem;width:36px;text-align:center;">@feat.Item1</span>
                                <div>
                                    <div class="fw-bold text-white" style="font-family:'Kanit',sans-serif;font-size:.9rem;">@feat.Item2</div>
                                    <div style="font-size:.78rem;color:rgba(242,240,235,.4);">@feat.Item3</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ CTA ════════════════════════════════════════════════ -->
    <section class="cta-section py-5 text-center">
        <div class="container" style="max-width:600px;">
            <h2 class="font-kanit fw-black mb-2" style="font-size:clamp(2rem,4vw,3rem);letter-spacing:-1.5px;">พร้อมจะร้องแล้วใช่ไหม?</h2>
            <p class="text-secondary mb-4">เลือกห้อง เลือกเวลา จองได้ทันทีทุกวัน</p>
            @if (isLoggedIn)
            {
                <a href="/user/booking" class="btn btn-dark px-5 py-3" style="font-size:.9rem;">จองห้องเลย →</a>
            }
            else
            {
                <a href="/user/auth" class="btn btn-dark px-5 py-3" style="font-size:.9rem;">เข้าสู่ระบบ →</a>
            }
        </div>
    </section>
</div>
