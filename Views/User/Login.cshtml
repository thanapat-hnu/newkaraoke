@{
    Layout = "_LoginLayout";
}
<div>
    <!-- AUTH CARD -->
    <div class="auth-page">
        <div class="card border-0 w-100" style="max-width:420px;">

            <!-- Tabs (Bootstrap nav-tabs) -->
            <ul class="nav auth-tabs d-flex" id="authTab" role="tablist">
                <li class="nav-item flex-fill">
                    <button class="nav-link active w-100" data-bs-toggle="tab"
                            data-bs-target="#loginPane">เข้าสู่ระบบ</button>
                </li>
                <li class="nav-item flex-fill">
                    <button class="nav-link w-100" data-bs-toggle="tab"
                            data-bs-target="#registerPane">สมัครสมาชิก</button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- LOGIN -->
                <div class="tab-pane fade show active p-4" id="loginPane">
                    <div class="mb-3">
                        <div class="auth-heading mb-1">ยินดีต้อนรับกลับ</div>
                        <div class="text-secondary" style="font-size:.83rem;">เข้าสู่ระบบเพื่อจองห้องคาราโอเกะ</div>
                    </div>

                    <!-- Bootstrap Alert (hidden by default) -->
                    <div class="alert alert-danger py-2 small d-none" id="lErr">อีเมลหรือรหัสผ่านไม่ถูกต้อง</div>

                    <div class="vstack gap-3">
                        <div>
                            <label class="form-label">อีเมล</label>
                            <input type="email" class="form-control" id="lEmail" placeholder="your@email.com">
                        </div>
                        <div>
                            <label class="form-label">รหัสผ่าน</label>
                            <input type="password" class="form-control" id="lPass" placeholder="••••••••">
                        </div>
                        <button class="btn btn-dark w-100" onclick="doLogin()">เข้าสู่ระบบ</button>
                    </div>

                    <p class="text-center text-secondary small mt-3 mb-0">
                        ยังไม่มีบัญชี?
                        <a href="#" class="text-dark fw-semibold text-decoration-underline"
                               onclick="bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target=\'#registerPane\']')).show()">
                            สมัครสมาชิก
                        </a>
                    </p>
                    <div class="text-center text-secondary border-top pt-3 mt-3" style="font-size:.72rem;">
                        ทดลองใช้: <strong>demo@demo.com</strong> / <strong>demo123</strong>
                    </div>
                </div>

                <!-- REGISTER -->
                <div class="tab-pane fade p-4" id="registerPane">
                    <div class="mb-3">
                        <div class="auth-heading mb-1">สร้างบัญชีใหม่</div>
                        <div class="text-secondary" style="font-size:.83rem;">สมัครฟรี เริ่มจองห้องทันที</div>
                    </div>

                    <div class="alert alert-danger py-2 small d-none" id="rErr">กรุณากรอกข้อมูลให้ครบ</div>

                    <div class="vstack gap-3">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">ชื่อ-นามสกุล</label>
                                <input type="text" class="form-control" id="rName" placeholder="ชื่อของคุณ">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">เบอร์โทรศัพท์</label>
                                <input type="tel" class="form-control" id="rPhone" placeholder="08X-XXX-XXXX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">วันเกิด</label>
                                <input type="date" class="form-control" id="rBirthday" style="color-scheme:light;">
                            </div>
                            <div class="col-12">
                                <label class="form-label">อีเมล</label>
                                <input type="email" class="form-control" id="rEmail" placeholder="your@email.com">
                            </div>
                            <div class="col-12">
                                <label class="form-label">รหัสผ่าน (อย่างน้อย 6 ตัว)</label>
                                <input type="password" class="form-control" id="rPass" placeholder="••••••••">
                            </div>
                        </div>
                        <button class="btn btn-dark w-100" onclick="doRegister()">สมัครสมาชิก</button>
                    </div>

                    <p class="text-center text-secondary small mt-3 mb-0">
                        มีบัญชีแล้ว?
                        <a href="#" class="text-dark fw-semibold text-decoration-underline"
                               onclick="bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target=\'#loginPane\']')).show()">
                            เข้าสู่ระบบ
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>